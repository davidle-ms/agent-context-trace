{
  "name": "agent-context-trace",
  "displayName": "Agent Context Trace",
  "description": "Visualize recorded agent file reads in a toggleable repository tree.",
  "version": "0.1.0",
  "publisher": "davidle-ms",
  "private": true,
  "license": "UNLICENSED",
  "repository": { "type": "git", "url": "https://github.com/davidle-ms/agent-context-trace.git" },
  "engines": { "vscode": "^1.100.0" },
  "categories": ["Other"],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": { "supported": false, "description": "Tracked source reads require a trusted local workspace." },
    "virtualWorkspaces": { "supported": false }
  },
  "activationEvents": [],
  "scripts": {
    "compile": "tsc -p .",
    "check-types": "tsc -p . --noEmit",
    "watch": "tsc -w -p .",
    "test:unit": "npm run compile && node --test out/test/core.test.js",
    "test:extension": "npm run compile && node scripts/test-host.cjs",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.0.0",
    "typescript": "~5.9.3"
  }
}