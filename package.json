{
  "name": "agent-context-trace",
  "displayName": "Agent Context Trace",
  "description": "Color recorded agent-read filenames in VS Code's built-in Explorer.",
  "version": "0.1.0",
  "publisher": "davidle-ms",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidle-ms/agent-context-trace.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Tracked source reads require a trusted local workspace."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "activationEvents": [
    "onLanguageModelTool:read_agent_context"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "agentContextTrace.readCoverage",
          "name": "Agent Read Coverage",
          "when": "isWorkspaceTrusted"
        }
      ]
    },
    "commands": [
      {
        "command": "agentContextTrace.selectCopilotSession",
        "title": "Agent Context Trace: Choose Copilot Chat Session",
        "icon": "$(history)"
      },
      {
        "command": "agentContextTrace.start",
        "title": "Agent Context Trace: Start Session",
        "icon": "$(play)"
      },
      {
        "command": "agentContextTrace.pauseResume",
        "title": "Agent Context Trace: Pause / Resume Session"
      },
      {
        "command": "agentContextTrace.stop",
        "title": "Agent Context Trace: Stop Session",
        "icon": "$(debug-stop)"
      },
      {
        "command": "agentContextTrace.selectSession",
        "title": "Agent Context Trace: Select Tracker History",
        "icon": "$(history)"
      },
      {
        "command": "agentContextTrace.copyReference",
        "title": "Agent Context Trace: Copy Session Tool Reference"
      },
      {
        "command": "agentContextTrace.toggleFileColors",
        "title": "Agent Context Trace: Toggle Read Colors",
        "icon": "$(eye)"
      },
      {
        "command": "agentContextTrace.showDetails",
        "title": "Show Recorded Read Details",
        "icon": "$(list-selection)"
      },
      {
        "command": "agentContextTrace.export",
        "title": "Agent Context Trace: Export Selected Session"
      },
      {
        "command": "agentContextTrace.delete",
        "title": "Agent Context Trace: Delete Tracker / Disconnect Chat History"
      },
      {
        "command": "agentContextTrace.refresh",
        "title": "Agent Context Trace: Refresh Repository",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentContextTrace.selectCopilotSession",
          "when": "view == agentContextTrace.readCoverage",
          "group": "navigation@1"
        },
        {
          "command": "agentContextTrace.start",
          "when": "view == agentContextTrace.readCoverage",
          "group": "navigation@2"
        },
        {
          "command": "agentContextTrace.toggleFileColors",
          "when": "view == agentContextTrace.readCoverage",
          "group": "navigation@3"
        },
        {
          "command": "agentContextTrace.refresh",
          "when": "view == agentContextTrace.readCoverage",
          "group": "navigation@4"
        }
      ],
      "explorer/context": [
        {
          "command": "agentContextTrace.showDetails",
          "when": "resourceScheme == file && !explorerResourceIsFolder && isWorkspaceTrusted",
          "group": "navigation@20"
        }
      ]
    },
    "colors": [
      {
        "id": "agentContextTrace.readFileForeground",
        "description": "Amber filename with one recorded read in the selected session.",
        "defaults": {
          "light": "#8A5C00",
          "dark": "#E8B35A",
          "highContrast": "#FFE0A3",
          "highContrastLight": "#704900"
        }
      },
      {
        "id": "agentContextTrace.readSectionBackground",
        "description": "Amber background for lines read once in the selected session. Indicates read frequency, not a warning. Hover for source-revision details.",
        "defaults": { "light": "#C0800014", "dark": "#E8B35A18", "highContrast": "#E8B35A18", "highContrastLight": "#C0800014" }
      },
      {
        "id": "agentContextTrace.readSectionBorder",
        "description": "Amber vertical border and ruler marker for lines read once in the selected session.",
        "defaults": { "light": "#8A5C00", "dark": "#E8B35A", "highContrast": "#FFE0A3", "highContrastLight": "#704900" }
      },
      {
        "id": "agentContextTrace.readFileRepeatForeground",
        "description": "Amber filename and vertical section border for 2-3 recorded reads in the selected session.",
        "defaults": { "light": "#784F00", "dark": "#DAA044", "highContrast": "#F5CB81", "highContrastLight": "#603E00" }
      },
      {
        "id": "agentContextTrace.readFileFrequentForeground",
        "description": "Amber filename and vertical section border for 4-7 recorded reads in the selected session.",
        "defaults": { "light": "#664200", "dark": "#CC902E", "highContrast": "#E8B35A", "highContrastLight": "#503300" }
      },
      {
        "id": "agentContextTrace.readFileIntenseForeground",
        "description": "Amber filename and vertical section border for 8 or more recorded reads in the selected session.",
        "defaults": { "light": "#553600", "dark": "#BF841C", "highContrast": "#DAA044", "highContrastLight": "#402800" }
      },
      {
        "id": "agentContextTrace.readSectionRepeatBackground",
        "description": "Amber section background for 2-3 recorded reads per line in the selected session.",
        "defaults": { "light": "#C0800030", "dark": "#E8B35A30", "highContrast": "#E8B35A30", "highContrastLight": "#C0800030" }
      },
      {
        "id": "agentContextTrace.readSectionFrequentBackground",
        "description": "Amber section background for 4-7 recorded reads per line in the selected session.",
        "defaults": { "light": "#C0800050", "dark": "#E8B35A50", "highContrast": "#E8B35A50", "highContrastLight": "#C0800050" }
      },
      {
        "id": "agentContextTrace.readSectionIntenseBackground",
        "description": "Amber section background for 8 or more recorded reads per line in the selected session.",
        "defaults": { "light": "#C0800070", "dark": "#E8B35A78", "highContrast": "#E8B35A78", "highContrastLight": "#C0800070" }
      }
    ],
    "configuration": {
      "title": "Agent Context Trace",
      "properties": {
        "agentContextTrace.showUnverifiedHistoryRanges": {
          "type": "boolean",
          "default": true,
          "description": "Show explicit saved-chat line ranges using the recorded-read color when no source revision exists. Hover text notes that the file may have changed. Guides are suppressed after edits while that session is selected."
        },
        "agentContextTrace.excludeGlobs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 256
          },
          "maxItems": 100,
          "default": [],
          "scope": "machine",
          "description": "Additional workspace-relative read exclusions. Built-in secret exclusions cannot be disabled. This does not inherit Copilot content exclusions."
        }
      }
    },
    "languageModelTools": [
      {
        "name": "read_agent_context",
        "toolReferenceName": "agentContextRead",
        "displayName": "Read File with Context Trace",
        "canBeReferencedInPrompt": true,
        "icon": "$(file-code)",
        "userDescription": "Read numbered workspace lines and record path/range metadata in the specified local tracker session.",
        "modelDescription": "Read a trusted local workspace text file with line numbers and record read metadata in Agent Context Trace. Use only when the user supplies a tracker session ID. You MUST pass that exact sessionId. Does not capture other tools or identify Copilot sessions. Requires explicit positive inclusive startLine/endLine, up to 500 lines, text under 1 MiB, and a non-excluded absolute local file path. If blocked, explain the issue; do not use a different tool to bypass the exclusion.",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sessionId",
            "filePath",
            "startLine",
            "endLine"
          ],
          "properties": {
            "sessionId": {
              "type": "string",
              "description": "Exact tracker session UUID supplied by the user."
            },
            "filePath": {
              "type": "string",
              "description": "Absolute path to a local workspace text file."
            },
            "startLine": {
              "type": "integer",
              "minimum": 1,
              "description": "First line, 1-based inclusive."
            },
            "endLine": {
              "type": "integer",
              "minimum": 1,
              "description": "Last line, 1-based inclusive; at most 500 requested lines."
            }
          }
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p . && esbuild src/extension.ts --bundle --platform=node --format=cjs --main-fields=module,main --target=node22 --external:vscode --outfile=dist/extension.js",
    "check-types": "tsc -p . --noEmit",
    "watch": "tsc -w -p .",
    "test:unit": "npm run compile && node --test out/test/core.test.js",
    "test:extension": "npm run compile && node scripts/test-host.cjs",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.2",
    "jsonc-parser": "^3.3.1",
    "minimatch": "^10.2.6",
    "playwright-core": "^1.63.0",
    "typescript": "~5.9.3"
  }
}
